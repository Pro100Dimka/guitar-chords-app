{
  "expo": {
    "name": "guitar-chords-songs",
    "slug": "guitar-chords-songs",
    "version": "0.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/guitar-pick.png",
    "scheme": "guitarchordssongs",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/guitar-pick.png",
      "splash": {
        "image": "./assets/images/guitar-pick.png",
        "resizeMode": "contain",
        "backgroundColor": "transparent"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/guitar-pick.png",
        "backgroundColor": "transparent"
      },
      "splash": {
        "image": "./assets/images/guitar-pick.png",
        "resizeMode": "contain",
        "backgroundColor": "transparent"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/guitar-pick.png",
      "splash": {
        "image": "./assets/images/guitar-pick.png",
        "resizeMode": "contain",
        "backgroundColor": "transparent"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
