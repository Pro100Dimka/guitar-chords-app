{
  "expo": {
    "name": "guitar-chords-songs",
    "slug": "guitar-chords-songs",
    "version": "0.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/guitar-pick.png",
    "scheme": "guitarchordssongs",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/guitar-pick.png",
      "splash": {
        "image": "./assets/images/guitar-pick.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "bundleIdentifier": "com.pro100dimka.guitarchordssongs",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/guitar-pick.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/images/guitar-pick.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pro100dimka.guitarchordssongs"
    },
    "web": {
      "favicon": "./assets/images/guitar-pick.png",
      "splash": {
        "image": "./assets/images/guitar-pick.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cab569ba-eb39-4f5f-856f-7936bf734ec5"
      }
    },
    "owner": "pro100dimka"
  }
}
