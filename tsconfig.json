// tsconfig.json
{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "checkJs": true,
    "types": ["jest"],
    "paths": {
      "*": ["/*"],
      "@/*": ["./src/*"]
    },
    "typeRoots": ["./src/@types", "./node_modules/@types"]
  },
  // "include": ["src/**/*", "**/*.ts", "**/*.tsx", "index.tsx"],
  // CommonJS files are Node tools/configuration, outside the React Native program.
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "ios",
    "android",
    "web",
    "**/*.cjs"
  ]
}
