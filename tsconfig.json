// tsconfig.json
{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "strict": true,
    "checkJs": true,
    "paths": {
      "*": ["/*"],
      "@/*": ["./src/*"]
    },
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  // "include": [
  //   "src/**/*.ts",
  //   "src/**/*.tsx",
  //   "src/**/*.js",
  //   "src/**/*.jsx",
  //   "*.ts",
  //   "*.js"
  // ],
  "exclude": ["node_modules", "dist", "build", "ios", "android", "web", "*.cjs"]
}
